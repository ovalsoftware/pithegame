source "https://rubygems.org"

# GitHub Pages builds this site automatically using the `github-pages` gem,
# which pins Jekyll and all supported plugin versions to match what runs on
# pages.github.com. This Gemfile mirrors that environment so local builds
# stay in sync with production.
#
# See: https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins
